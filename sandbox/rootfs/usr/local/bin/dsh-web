#!/usr/bin/env bash
# Launch the DSH Web profile on loopback. Caddy is the only public listener.
set -euo pipefail

: "${DSH_HOME:=/home/workspace/.dsh}"
export DSH_HOME

if [ -r /opt/toolchain/env.sh ]; then
  # shellcheck disable=SC1091
  . /opt/toolchain/env.sh
fi

# Launcher flags must come before the app's own flags. The second patch
# removes the shipped DeepSeek model default; users configure a provider in
# Settings -> Models (or via injected DSH_DEFAULT_LLM_* defaults).
args=(--profile web --patch /etc/dsh/sandbox.patch.yml --patch /etc/dsh/no-default-model.patch.yml)

# Enable Metis zero-redirect ForwardAuth plugin on DSH >= 0.2.3 when configured.
gateway_auth_mode="${DSH_GATEWAY_AUTH_MODE:-auto}"
gateway_auth_active="${DSH_GATEWAY_AUTH_ACTIVE:-}"
if [ -z "${gateway_auth_active}" ]; then
  if [ "${gateway_auth_mode}" = "gateway" ]; then
    gateway_auth_active=true
  elif [ "${gateway_auth_mode}" = "auto" ] \
    && [ -n "${METIS_GATEWAY_AUTH_SECRET:-}" ] \
    && [ -d /usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-host-authentication-token ]; then
    gateway_auth_active=true
  else
    gateway_auth_active=false
  fi
fi
if [ "${gateway_auth_active}" = "true" ] && [ -f /etc/dsh/gateway-auth.patch.yml ]; then
  args+=(--patch /etc/dsh/gateway-auth.patch.yml)
fi

# First run: pre-seed DSH's default workspace directly under the user home
# directory (/home/workspace/default-workspace) instead of nesting under
# /home/workspace/deepseek-harness/default-workspace, while keeping
# /home/workspace itself as the user's home directory rather than a workspace.
workspace_store="${DSH_HOME}/storages/workspace.json"
if [ ! -f "${workspace_store}" ]; then
  WORKSPACE_STORE="${workspace_store}" DEFAULT_WS_DIR="${HOME:-/home/workspace}/default-workspace" node -e '
    const fs = require("fs");
    const path = require("path");
    const { randomUUID } = require("crypto");
    const storePath = process.env.WORKSPACE_STORE;
    const wsDir = process.env.DEFAULT_WS_DIR;
    fs.mkdirSync(wsDir, { recursive: true });
    fs.mkdirSync(path.dirname(storePath), { recursive: true });
    const realWsDir = fs.realpathSync(wsDir);
    const id = randomUUID();
    const now = new Date().toISOString();
    const data = {
      unit: { name: "workspace", version: 2 },
      global: {
        initialized: true,
        defaultWorkspaceId: id,
        workspaceIds: [id],
        archivedSessionIds: [],
        pinnedSessionIds: [],
      },
      tables: {
        workspaces: {
          [id]: {
            path: realWsDir,
            title: "default-workspace",
            sessionIds: [],
            createdAt: now,
            updatedAt: now,
          },
        },
      },
    };
    fs.writeFileSync(storePath, JSON.stringify(data, null, 2) + "\n", "utf8");
  ' || true
fi

# pi-ai requires a non-empty API key even for keyless local OpenAI-compatible
# endpoints (Ollama / vLLM / LM Studio / Strata). Provide a benign placeholder
# when a custom base URL is configured without an explicit API key.
if [ -n "${DSH_DEFAULT_LLM_BASE_URL:-}" ] && [ -z "${DSH_DEFAULT_LLM_API_KEY:-}" ]; then
  export DSH_DEFAULT_LLM_API_KEY="local-no-key"
fi

# First run: write default model + provider config into the profile patch when
# not yet configured. Settings -> Models later edits these rows, and this check
# skips them so user selections always survive restarts.
profile_patch="${DSH_HOME}/profiles/web/cordis.patch.yml"
if [ -f "${profile_patch}" ]; then
  PROFILE_PATCH="${profile_patch}" node -e '
    const fs = require("fs");
    const patchPath = process.env.PROFILE_PATCH;
    let content = fs.readFileSync(patchPath, "utf8");
    const cleanStrip = () => content.replace(/^\s*\[\]\s*$/m, "").trimEnd();
    const provider = (process.env.DSH_DEFAULT_LLM_PROVIDER || "").trim();
    const model = (process.env.DSH_DEFAULT_LLM_MODEL || "").trim();
    const baseUrl = (process.env.DSH_DEFAULT_LLM_BASE_URL || "").trim();
    const api = (process.env.DSH_DEFAULT_LLM_API || "openai-completions").trim();
    const displayName = (process.env.DSH_DEFAULT_LLM_DISPLAY_NAME || "").trim();
    const apiKey = (process.env.DSH_DEFAULT_LLM_API_KEY || "").trim();
    const ctxWin = Number.parseInt(process.env.DSH_DEFAULT_LLM_CONTEXT_WINDOW || "", 10);
    const maxTok = Number.parseInt(process.env.DSH_DEFAULT_LLM_MAX_TOKENS || "", 10);
    const supportsImage = (process.env.DSH_DEFAULT_LLM_SUPPORTS_IMAGE || "").trim().toLowerCase() === "true";
    const reasoningEffort = (process.env.DSH_DEFAULT_LLM_REASONING_EFFORT || "").trim().toLowerCase();
    const thinkingFormat = (process.env.DSH_DEFAULT_LLM_THINKING_FORMAT || "").trim();
    const validEfforts = new Set(["off", "minimal", "low", "medium", "high", "xhigh", "max"]);
    let changed = false;

    if (!content.includes("id: agent-default-model")) {
      const lines = [
        "",
        "- id: agent-default-model",
        "  config:",
        "    provider: " + JSON.stringify(provider),
        "    model: " + JSON.stringify(model),
      ];
      if (validEfforts.has(reasoningEffort) && reasoningEffort !== "off") {
        lines.push("    reasoningEffort: " + JSON.stringify(reasoningEffort));
      }
      content = cleanStrip() + "\n" + lines.join("\n") + "\n";
      changed = true;
    }

    if (provider && baseUrl && model && !content.includes("id: llm-pi-ai")) {
      const lines = [
        "",
        "- id: llm-pi-ai",
        "  name: \"@deepseek-ai/dsh-llm-pi-ai\"",
        "  config:",
        "    providers:",
        "      " + JSON.stringify(provider) + ":",
        "        api: " + JSON.stringify(api),
        "        baseURL: " + JSON.stringify(baseUrl),
      ];
      if (displayName) {
        lines.push("        displayName: " + JSON.stringify(displayName));
      }
      lines.push("        apiKeyEnv: DSH_DEFAULT_LLM_API_KEY");
      if (validEfforts.has(reasoningEffort)) {
        lines.push("        reasoning: " + JSON.stringify(reasoningEffort));
      }
      if (thinkingFormat && api === "openai-completions") {
        lines.push("        compat:");
        lines.push("          thinkingFormat: " + JSON.stringify(thinkingFormat));
      }
      lines.push("        models:");
      lines.push("          - id: " + JSON.stringify(model));
      lines.push("            name: " + JSON.stringify(model));
      if (Number.isFinite(ctxWin) && ctxWin >= 1024) {
        lines.push("            contextWindow: " + ctxWin);
      }
      if (Number.isFinite(maxTok) && maxTok >= 128) {
        lines.push("            maxTokens: " + maxTok);
      }
      lines.push("            input:");
      lines.push("              - text");
      if (supportsImage) {
        lines.push("              - image");
      }
      if (reasoningEffort === "off") {
        lines.push("            reasoningEfforts: false");
      } else if (validEfforts.has(reasoningEffort)) {
        lines.push("            reasoningEfforts:");
        lines.push("              off: null");
        lines.push("              minimal: minimal");
        lines.push("              low: low");
        lines.push("              medium: medium");
        lines.push("              high: high");
        lines.push("              xhigh: xhigh");
        lines.push("              max: max");
      }
      content = cleanStrip() + "\n" + lines.join("\n") + "\n";
      changed = true;
    }

    if (changed) {
      fs.writeFileSync(patchPath, content.replace(/^\n+/, ""));
    }
  ' || true
fi

# Automatically enable the DSH Plugin Market (Discover tab), inject the
# platform's self-hosted plugin index URL, and point the web profile's pnpm
# registry to the self-hosted npm proxy so in-app update checks & updates work.
plugin_index_url="${DSH_PLUGIN_INDEX_URL:-}"
if [ -z "${plugin_index_url}" ] && [ -s /home/workspace/.dsh-sandbox/plugin-index-url.txt ]; then
  plugin_index_url="$(head -n 1 /home/workspace/.dsh-sandbox/plugin-index-url.txt | tr -d '\r\n')"
fi
plugin_npm_registry="${DSH_PLUGIN_NPM_REGISTRY:-}"
if [ -z "${plugin_npm_registry}" ] && [ -s /home/workspace/.dsh-sandbox/plugin-npm-registry.txt ]; then
  plugin_npm_registry="$(head -n 1 /home/workspace/.dsh-sandbox/plugin-npm-registry.txt | tr -d '\r\n')"
fi
if [ -z "${plugin_npm_registry}" ] && [[ "${plugin_index_url}" == */index.json ]]; then
  plugin_npm_registry="${plugin_index_url%/index.json}/npm"
fi
plugin_extra_indexes="${DSH_EXTRA_PLUGIN_INDEX_URLS:-}"
if [ -z "${plugin_extra_indexes}" ] && [ -s /home/workspace/.dsh-sandbox/plugin-extra-indexes.json ]; then
  plugin_extra_indexes="$(cat /home/workspace/.dsh-sandbox/plugin-extra-indexes.json)"
fi
if [ -n "${plugin_index_url}" ] || [ -n "${plugin_npm_registry}" ] || [ -n "${plugin_extra_indexes}" ]; then
  PLUGIN_INDEX_URL="${plugin_index_url}" PLUGIN_EXTRA_INDEXES="${plugin_extra_indexes}" PLUGIN_NPM_REGISTRY="${plugin_npm_registry}" DSH_PROFILE_DIR="${DSH_HOME}/profiles/web" node -e '
    const fs = require("fs");
    const path = require("path");
    const dir = process.env.DSH_PROFILE_DIR;
    const indexUrl = (process.env.PLUGIN_INDEX_URL || "").trim();
    const npmRegistry = (process.env.PLUGIN_NPM_REGISTRY || "").trim();
    let extraIndexes = [];
    if (process.env.PLUGIN_EXTRA_INDEXES) {
      try {
        const parsed = JSON.parse(process.env.PLUGIN_EXTRA_INDEXES);
        if (Array.isArray(parsed)) {
          extraIndexes = parsed.map((x) => String(x || "").trim()).filter(Boolean);
        }
      } catch {}
    }
    const desiredIndexes = [];
    for (const u of [indexUrl, ...extraIndexes]) {
      if (u && !desiredIndexes.includes(u)) desiredIndexes.push(u);
    }
    const pkgPath = path.join(dir, "package.json");
    const patchPath = path.join(dir, "cordis.patch.yml");
    const npmrcPath = path.join(dir, ".npmrc");
    if (npmRegistry && fs.existsSync(dir)) {
      const cur = fs.existsSync(npmrcPath) ? fs.readFileSync(npmrcPath, "utf8") : "";
      const lines = cur.split(/\r?\n/).filter((l) => l.trim() !== "" && !/^registry\s*=/.test(l.trim()));
      lines.unshift("registry=" + npmRegistry);
      fs.writeFileSync(npmrcPath, lines.join("\n") + "\n");
    }
    if (desiredIndexes.length > 0 && fs.existsSync(pkgPath)) {
      const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
      pkg.dsh = pkg.dsh || {};
      pkg.dsh.profile = pkg.dsh.profile || {};
      pkg.dsh.profile.bundles = Array.isArray(pkg.dsh.profile.bundles) ? pkg.dsh.profile.bundles : [];
      const marketBundle = "@deepseek-ai/dsh-experimental-plugin-market-bundle";
      if (!pkg.dsh.profile.bundles.includes(marketBundle)) {
        pkg.dsh.profile.bundles.push(marketBundle);
        fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2) + "\n");
      }
    }
    if (desiredIndexes.length > 0 && fs.existsSync(patchPath)) {
      let yaml;
      try {
        yaml = require("/usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/yaml");
      } catch {
        yaml = null;
      }
      if (yaml) {
        const raw = fs.readFileSync(patchPath, "utf8");
        let parsed = yaml.parse(raw);
        if (!Array.isArray(parsed)) parsed = [];
        let entry = parsed.find((x) => x && typeof x === "object" && x.id === "plugin-market");
        if (!entry) {
          entry = { id: "plugin-market", name: "@deepseek-ai/dsh-plugin-market", config: { indexes: [] } };
          parsed.push(entry);
        }
        if (!entry.name) entry.name = "@deepseek-ai/dsh-plugin-market";
        if (!entry.config || typeof entry.config !== "object") entry.config = {};
        const existing = Array.isArray(entry.config.indexes) ? entry.config.indexes.map((x) => String(x || "").trim()).filter(Boolean) : [];
        const merged = [...desiredIndexes];
        for (const u of existing) {
          if (!merged.includes(u)) merged.push(u);
        }
        entry.config.indexes = merged;
        fs.writeFileSync(patchPath, yaml.stringify(parsed));
      } else {
        let content = fs.readFileSync(patchPath, "utf8").replace(/^\s*\[\]\s*$/m, "");
        if (!content.includes("id: plugin-market")) {
          const lines = desiredIndexes.map((u) => "      - " + JSON.stringify(u)).join("\n");
          content = content.trimEnd() + "\n\n- id: plugin-market\n  name: \"@deepseek-ai/dsh-plugin-market\"\n  config:\n    indexes:\n" + lines + "\n";
          fs.writeFileSync(patchPath, content);
        }
      }
    }
  ' || true
fi

args+=(--no-open --host 127.0.0.1 --port "${DSH_PORT:-3080}")

if [ -n "${DSH_PUBLIC_URL:-}" ]; then
  args+=(--public-url "${DSH_PUBLIC_URL}")
fi

read -r -a trusted_hosts <<<"${DSH_TRUSTED_HOSTS:-}"
for host in "${trusted_hosts[@]}"; do
  [ -n "${host}" ] || continue
  args+=(--trusted-host "${host}")
done

# The token helper reads the launch URL from this file after OIDC login.
mkdir -p "${DSH_HOME}"
exec > >(tee -a "${DSH_HOME}/web.log") 2>&1
exec dsh "${args[@]}"
