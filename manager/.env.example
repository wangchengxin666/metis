# --- Relational Database (PostgreSQL / SQL Server / MySQL; SQLite opt-in only) ---
# Production default (matches built-in postgres service in docker-compose.yml):
DATABASE_URL=postgresql+psycopg://dsh:dsh-secret-password@postgres:5432/dsh_manager
# Microsoft SQL Server examples:
# DATABASE_URL=mssql+pymssql://sa:StrongPass!@mssql:1433/dsh_manager
# DATABASE_URL=mssql://sa:StrongPass!@mssql:1433/dsh_manager
# MySQL / MariaDB example (pymysql):
# DATABASE_URL=mysql+pymysql://dsh:dsh-secret-password@mysql:3306/dsh_manager
# Single-node dev/test only (forbidden when MANAGER_WORKERS > 1):
# ALLOW_SQLITE=true
# DATABASE_URL=sqlite:////data/dsh-manager.db
# Optional automatic one-time migration from legacy SQLite into Postgres/MSSQL when target tables are empty:
# AUTO_MIGRATE_SQLITE_PATH=/data/dsh-manager.db
# Connection pool tuning for PostgreSQL / SQL Server / MySQL:
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# --- Distributed Control-Plane Coordination (Redis + Multi-Worker) ----------
REDIS_URL=redis://redis:6379/0
MANAGER_WORKERS=2
# DISTRIBUTED_LOCK_TTL_SECONDS=30
# LLM_GATEWAY_CONCURRENT_LIMIT=32
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine

# --- Sandbox Runtime Backend ('docker' or 'kubernetes') ---------------------
SANDBOX_RUNTIME=docker

# --- Optional Remote Docker Daemon & TLS (when SANDBOX_RUNTIME=docker) ------
# Leave empty to use local DOCKER_SOCKET (/var/run/docker.sock) on bridge network.
# For remote Docker over TCP or SSH:
# DOCKER_HOST=tcp://10.0.0.20:2376
# DOCKER_PUBLIC_HOST=10.0.0.20
# DOCKER_HOST_PORT_BIND_IP=0.0.0.0
# DOCKER_TLS_VERIFY=true
# DOCKER_TLS_CA_CERT=/etc/dsh/docker-tls/ca.pem
# DOCKER_TLS_CLIENT_CERT=/etc/dsh/docker-tls/cert.pem
# DOCKER_TLS_CLIENT_KEY=/etc/dsh/docker-tls/key.pem

# --- Optional Kubernetes Runtime Settings (when SANDBOX_RUNTIME=kubernetes) -
# K8S_NAMESPACE=dsh-sandboxes
# K8S_IN_CLUSTER=true
# K8S_KUBECONFIG_PATH=
# K8S_CONTEXT=
# K8S_STORAGE_CLASS=
# K8S_WORKSPACE_STORAGE_SIZE=20Gi
# K8S_IMAGE_PULL_SECRET=
# K8S_IMAGE_PULL_POLICY=IfNotPresent
# K8S_SERVICE_DOMAIN=cluster.local
# K8S_ROUTING_MODE: 'traefik-http' (manager serves dynamic routes to Traefik) or 'traefik-crd' (creates IngressRoute CRDs)
# K8S_ROUTING_MODE=traefik-http
# K8S_TRAEFIK_ENTRYPOINT=web

# --- Traefik Dynamic HTTP Provider ------------------------------------------
# Optional token protecting GET /api/internal/traefik/config
# TRAEFIK_PROVIDER_TOKEN=
# TRAEFIK_ENTRYPOINT=web

MANAGER_IMAGE_REPO=dsh-manager
MANAGER_IMAGE_TAG=latest
TRAEFIK_IMAGE=traefik:v3.7
GATEWAY_PORT=9000
DOCKER_API_VERSION=1.44

# --- Optional build-time mirrors (for internal networks / CN mirrors) -------
# PYTHON_IMAGE=python:3.13-slim
# NODE_IMAGE=node:24-bookworm-slim
# APT_MIRROR=https://mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com

DSH_IMAGE_REPO=dsh-sandbox
DSH_IMAGE_TAG=latest
DSH_NETWORK=dsh-manager
# Set true if the Docker daemon is logged in to the registry and may pull.
PULL_MISSING_IMAGE=false
DSH_PERMISSION_MODE=danger-full-access
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2.0
SANDBOX_TIMEZONE=UTC
# Optional host path to a custom/enterprise CA PEM file to mount/inject into sandboxes:
# CUSTOM_CA_BUNDLE_PATH=
HEALTH_TIMEOUT_SECONDS=75

BACKGROUND_TASKS=true
RECONCILE_INTERVAL_SECONDS=60

# --- Authentication mode ----------------------------------------------------
# MANAGER_AUTH_MODE:
#   - 'token' (recommended): Admin Token + local user password + internal multi-OIDC SSO (configured in Admin Console -> Auth & SSO)
#   - 'oidc': OIDC-first mode (auto-imports legacy OIDC_* env vars below on first boot; defaults local user login off)
#   - 'none': passwordless local dev
MANAGER_AUTH_MODE=token

# Bootstrap administrator email (seeded into platform_admins on first start).
MANAGER_ADMIN_EMAIL=admin@example.com
# Required when MANAGER_AUTH_MODE=token (also usable as Bearer token on /api/* and emergency admin fallback).
MANAGER_ADMIN_TOKEN=replace-with-admin-token
# Public manager & gateway URL (used for sandbox URLs, OIDC callbacks, and plugin index links).
MANAGER_PUBLIC_URL=http://localhost:9000
# Internal URL reachable from inside sandbox containers (e.g. http://dsh-manager:9000).
# MANAGER_INTERNAL_URL=http://dsh-manager:9000
# Startup rejects the placeholder; generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret

# --- Optional legacy/bootstrap OIDC settings --------------------------------
# Recommended: leave commented out and manage one or multiple OIDC providers
# directly in the Admin Console -> Auth & SSO (stored encrypted in DB, hot-reloaded without restarting).
# If set on first start, these values are auto-imported once as the 'default' OIDC provider.
# OIDC_ISSUER_URL=https://idp.example.com/realms/main
# OIDC_DISCOVERY_URL=http://dsh-keycloak:8080/realms/main/.well-known/openid-configuration
# OIDC_CLIENT_ID=dsh-sandbox
# OIDC_CLIENT_SECRET=replace-with-client-secret
# OIDC_SCOPE=openid profile email
# OIDC_EMAIL_CLAIM=email
# OIDC_LOGOUT_URL=

# --- Self-Hosted Plugin Index & Registry ------------------------------------
# PLUGIN_SOURCE_TYPE: 'npm' (served directly by manager at /plugins/npm) or 'git'
PLUGIN_SOURCE_TYPE=npm
# Auto-install plugins into newly created sandboxes (comma-separated slugs or URLs):
SANDBOX_AUTO_INSTALL_PLUGINS=file-manager,workspace-user,custom-theme,sandbox-mesh,sandbox-memory,work-delivery
# Optional overrides for custom branding or internal Git hosting:
# PLUGIN_INDEX_TITLE_EN=DSH Sandbox Plugins
# PLUGIN_INDEX_TITLE_ZH=DSH 沙箱平台插件
# PLUGIN_INDEX_AUTHOR=DSH Sandbox Platform
# PLUGIN_GIT_URL=
# PLUGIN_GIT_COMMIT=

# Rootful Docker; on Podman use /run/podman/podman.sock.
DOCKER_SOCKET=/var/run/docker.sock
