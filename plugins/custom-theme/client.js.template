window.__ModuleLoader__.load({
  id: '@metis/custom-theme',
  factory(require) {
    const React = require('react')

    // __CLIENT_MODULES__

    function readActiveLocale(localeSvc) {
      if (!localeSvc) return undefined
      if (typeof localeSvc.getSnapshot === 'function') return localeSvc.getSnapshot()?.active
      if (typeof localeSvc.getLocale === 'function') return localeSvc.getLocale()?.active
      return undefined
    }

    function apply(ctx, syncedConfig = {}) {
      ctx.effect(() => installStyles(), 'custom-theme: styles')

      const subscribeLocale = (listener) => {
        if (ctx.locale && typeof ctx.locale.subscribe === 'function') {
          return ctx.locale.subscribe((snapshot) => listener(snapshot?.active))
        }
        if (typeof ctx.on === 'function') {
          return ctx.on('locale/change', (snapshot) => listener(snapshot?.active))
        }
        return () => {}
      }

      const controller = createThemeController({
        React,
        themeSvc: ctx.theme,
        slotsSvc: ctx.slots,
      })
      ctx.effect(() => () => { controller.dispose() }, 'custom-theme: controller lifecycle')

      // Live Volatile brand theme sync via DSH 0.2.3+ dsh-client-config
      const managedBrandRef = syncedConfig?.managedBrand
      if (managedBrandRef && typeof managedBrandRef.get === 'function') {
        const pushManaged = () => controller.applyManagedBrand(managedBrandRef.get())
        pushManaged()
        if (typeof managedBrandRef.subscribe === 'function') {
          const offBrand = managedBrandRef.subscribe(() => pushManaged())
          ctx.effect(() => offBrand, 'custom-theme: volatile managedBrand listener')
        }
      }

      if (typeof ctx.on === 'function') {
        const offTheme = ctx.on('theme/change', (snapshot) => controller.handleThemeChange(snapshot))
        ctx.effect(() => offTheme, 'custom-theme: theme listener')
      }

      void controller.syncFromHost()

      const CustomThemePage = createThemeSettingsPage({
        React,
        controller,
        getLocale: () => readActiveLocale(ctx.locale),
        subscribeLocale,
      })

      ctx.slots.inject('settings.section.icon', () =>
        ctx.slots.register(
          {
            name: 'settings.section.icon',
            id: 'custom-theme',
          },
          function CustomThemeSectionIcon({ size = 16 }) {
            return PaletteNavIcon({ React, size })
          },
        ),
      )

      ctx.slots.inject('settings.section', () => {
        let unregister = null
        const syncNav = () => {
          unregister?.()
          const t = createTranslator(readActiveLocale(ctx.locale))
          unregister = ctx.slots.register(
            {
              name: 'settings.section',
              id: 'custom-theme',
              order: 25,
              label: t('nav'),
            },
            CustomThemePage,
          )
        }
        syncNav()
        const offLocale = subscribeLocale(() => syncNav())
        return () => {
          offLocale()
          unregister?.()
          unregister = null
        }
      })
    }

    return {
      inject: ['slots', 'locale', 'theme'],
      apply,
    }
  },
})
