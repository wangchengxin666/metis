window.__ModuleLoader__.load({
  id: '@metis/sandbox-mesh',
  factory(require) {
    const React = require('react')

    // __CLIENT_MODULES__

    function readActiveLocale(localeSvc) {
      if (!localeSvc) return undefined
      if (typeof localeSvc.getSnapshot === 'function') return localeSvc.getSnapshot()?.active
      if (typeof localeSvc.getLocale === 'function') return localeSvc.getLocale()?.active
      return undefined
    }

    function buildNativeSessionAtTriggerSource({ controller, getLocale }) {
      return {
        trigger: '@',
        name: 'sandbox-mesh',
        order: -10,
        showGroupTitle: false,
        warm() {
          void controller.syncFromHost()
        },
        async candidates(_session, { query, quoted, signal }) {
          if (quoted) return []
          await controller.syncFromHost()
          if (signal?.aborted) return []
          const snap = controller.getSnapshot()
          const selfSlug = snap.state?.self?.slug || 'sandbox'
          const peers = snap.state?.peers || []
          const rooms = snap.state?.rooms || []
          const t = createTranslator(typeof getLocale === 'function' ? getLocale() : 'en')
          const section = t('triggerSectionPeers')
          const q = String(query || '').trim().toLowerCase()
          const items = []

          for (const peer of peers) {
            if (!peer?.slug) continue
            const match = !q
              || peer.slug.toLowerCase().includes(q)
              || String(peer.ownerName || '').toLowerCase().includes(q)
              || String(peer.role || '').toLowerCase().includes(q)
              || String(peer.description || '').toLowerCase().includes(q)
            if (!match) continue
            const pairRoom = rooms.find((r) => r.type === 'pair' && r.peerSlug === peer.slug)
            const rId = pairRoom?.id || pairRoomId(selfSlug, peer.slug)
            const roleSummary = [peer.role, peer.description].filter(Boolean).join(' — ')
            items.push({
              name: peer.slug,
              label: peer.role ? `${peer.slug} (${peer.role})` : peer.slug,
              description: roleSummary || `${peer.ownerName || peer.slug} · ${t('triggerPeerDesc')}`,
              icon: 'session',
              section,
              value: JSON.stringify({
                kind: 'peer',
                slug: peer.slug,
                ownerName: peer.ownerName || peer.slug,
                roomId: rId,
              }),
            })
          }

          for (const room of rooms) {
            if (room.type !== 'group' || room.unpaired) continue
            const match = !q
              || String(room.name || '').toLowerCase().includes(q)
              || String(room.id || '').toLowerCase().includes(q)
            if (!match) continue
            items.push({
              name: room.name || room.id,
              label: room.name || room.id,
              description: `${t('triggerGroupDesc')} (${(room.members || []).map((m) => m.slug).join(', ')})`,
              icon: 'session',
              section,
              value: JSON.stringify({
                kind: 'group',
                roomId: room.id,
                name: room.name || room.id,
              }),
            })
          }

          return items
        },
        onPick({ candidate }) {
          if (!candidate?.value) return undefined
          let parsed
          try {
            parsed = JSON.parse(candidate.value)
          } catch {
            return undefined
          }
          if (parsed?.kind === 'peer') {
            const mention = `@[${parsed.slug}](dsh-mesh:${parsed.slug})`
            return {
              insert: {
                source: 'sandbox-mesh',
                ref: mention,
                label: parsed.slug,
                appearance: 'session',
                clipboardText: `@${parsed.slug}`,
              },
            }
          }
          if (parsed?.kind === 'group') {
            const mention = `@[${parsed.name}](dsh-mesh-group:${parsed.roomId})`
            return {
              insert: {
                source: 'sandbox-mesh',
                ref: mention,
                label: parsed.name,
                appearance: 'session',
                clipboardText: `@${parsed.name}`,
              },
            }
          }
          return undefined
        },
        codec: {
          clipboardText(ref) {
            const match = /^@\[([^\]\n]+)\]\(dsh-mesh/.exec(String(ref || ''))
            if (match) return `@${match[1]}`
            return ref
          },
          async serialize(ref) {
            return String(ref || '')
          },
        },
      }
    }

    function apply(ctx) {
      ctx.effect(() => installStyles(), 'sandbox-mesh: styles')

      const subscribeLocale = (listener) => {
        if (ctx.locale && typeof ctx.locale.subscribe === 'function') {
          return ctx.locale.subscribe((snapshot) => listener(snapshot?.active))
        }
        if (typeof ctx.on === 'function') {
          return ctx.on('locale/change', (snapshot) => listener(snapshot?.active))
        }
        return () => {}
      }

      if (ctx.locale && typeof ctx.locale.register === 'function') {
        const disposeLocale = ctx.locale.register('sandboxMesh', { en, zh })
        ctx.effect(() => disposeLocale, 'sandbox-mesh: locale')
      }

      const controller = createMeshController()
      ctx.effect(() => () => { controller.dispose() }, 'sandbox-mesh: controller')

      void controller.syncFromHost()

      // Register `@` trigger source directly into DSH's native Session chat composer!
      if (typeof ctx.inject === 'function') {
        ctx.inject(['inputTriggers'], (trigCtx) => {
          const inputTriggers = trigCtx.inputTriggers ?? trigCtx.get?.('inputTriggers')
          if (!inputTriggers || typeof inputTriggers.registerSource !== 'function') return
          const src = buildNativeSessionAtTriggerSource({
            controller,
            getLocale: () => readActiveLocale(ctx.locale),
          })
          const disposeTrigger = inputTriggers.registerSource(src)
          trigCtx.effect(() => disposeTrigger, 'sandbox-mesh: native session @ trigger')
        })

        // Register userText rules & chip/card renderers so `@[slug](dsh-mesh:slug)`, legacy XML peer tags,
        // and `[SANDBOX MESH INCOMING REQUEST]` wake prompts render cleanly in DSH Session chat history!
        ctx.inject(['uiConversation'], (convCtx) => {
          const uiConv = convCtx.uiConversation ?? convCtx.get?.('uiConversation')
          if (!uiConv?.userText?.register) return
          const disposeMentionRule = uiConv.userText.register({
            id: 'sandbox-mesh',
            order: 8,
            match(text, from) {
              const pattern = /@\[([^\]\n]+)\]\(dsh-mesh(?:-[a-z]+)?:([^)\s]+)\)/gu
              pattern.lastIndex = from
              const m = pattern.exec(text)
              if (!m) return undefined
              return {
                id: 'sandbox-mesh',
                start: m.index,
                end: m.index + m[0].length,
                data: { label: m[1], target: m[2] },
              }
            },
          })
          const disposeLegacyPeerRule = uiConv.userText.register({
            id: 'sandbox-mesh-legacy-peer',
            order: 7,
            match(text, from) {
              const pattern = /<sandbox-mesh-peer\b[^>]*slug="([^"]+)"[^>]*>[\s\S]*?<\/sandbox-mesh-peer>/gu
              pattern.lastIndex = from
              const m = pattern.exec(text)
              if (!m) return undefined
              return {
                id: 'sandbox-mesh-legacy-peer',
                start: m.index,
                end: m.index + m[0].length,
                data: { label: m[1], target: m[1] },
              }
            },
          })
          const disposeWakeRule = uiConv.userText.register({
            id: 'sandbox-mesh-wake',
            order: 6,
            match(text, from) {
              if (from !== 0) return undefined
              const parsed = parseIncomingWakePrompt(text)
              if (!parsed) return undefined
              return {
                id: 'sandbox-mesh-wake',
                start: 0,
                end: text.length,
                data: parsed,
              }
            },
          })
          const MeshWakeCard = createMeshWakePromptView({
            React,
            getLocale: () => readActiveLocale(ctx.locale),
          })
          const disposeNodes = convCtx.slots.inject('conversation.user.text.node', () => {
            const d1 = convCtx.slots.register(
              {
                name: 'conversation.user.text.node',
                key: 'sandbox-mesh',
                priority: 100,
              },
              function MeshUserTextChip({ node, raw }) {
                const label = node?.data?.label || raw
                return React.createElement(
                  'span',
                  {
                    className: 'sm-inline-mention',
                    title: raw,
                  },
                  React.createElement(AgentIcon, { React, size: 12 }),
                  `@${label}`,
                )
              },
            )
            const d2 = convCtx.slots.register(
              {
                name: 'conversation.user.text.node',
                key: 'sandbox-mesh-legacy-peer',
                priority: 100,
              },
              function MeshLegacyPeerChip({ node }) {
                const label = node?.data?.label || 'peer'
                const t = createTranslator(readActiveLocale(ctx.locale))
                return React.createElement(
                  'span',
                  {
                    className: 'sm-inline-mention',
                    title: `${t('legacyPeerChipDesc')}: @${label}`,
                  },
                  React.createElement(AgentIcon, { React, size: 12 }),
                  `@${label}`,
                )
              },
            )
            const d3 = convCtx.slots.register(
              {
                name: 'conversation.user.text.node',
                key: 'sandbox-mesh-wake',
                priority: 100,
              },
              MeshWakeCard,
            )
            return () => {
              d1?.()
              d2?.()
              d3?.()
            }
          })
          convCtx.effect(() => () => {
            disposeMentionRule?.()
            disposeLegacyPeerRule?.()
            disposeWakeRule?.()
            disposeNodes?.()
          }, 'sandbox-mesh: userText chip & wake card rules')
        })
      }

      // Register native DSH tool call cards so `mesh_*` calls never dump raw JSON in main chat
      const MeshToolCard = createMeshToolView({
        React,
        controller,
        getLocale: () => readActiveLocale(ctx.locale),
        subscribeLocale,
      })
      const MESH_TOOL_NAMES = [
        'mesh_ask_peer',
        'mesh_discuss_group',
        'mesh_list_peers',
        'mesh_send_message',
        'mesh_share_file',
        'mesh_dispatch_tasks',
        'mesh_task_board',
        'mesh_task_update',
        'mesh_request_approval',
      ]
      ctx.slots.inject('tool.call.toolview', () => {
        const disposers = MESH_TOOL_NAMES.map((toolKey) =>
          ctx.slots.register(
            {
              name: 'tool.call.toolview',
              key: toolKey,
              priority: 100,
            },
            MeshToolCard,
          ),
        )
        return () => {
          for (const d of disposers) d?.()
        }
      })

      // Bind uiWorkspace reactively so "Agent Log" navigation works reliably across Cordis scopes
      const uiWorkspaceRef = { current: null }
      if (typeof ctx.inject === 'function') {
        ctx.inject(['uiWorkspace'], (wsCtx) => {
          const svc = wsCtx.uiWorkspace ?? wsCtx.get?.('uiWorkspace') ?? null
          uiWorkspaceRef.current = svc
          wsCtx.effect(() => () => {
            if (uiWorkspaceRef.current === svc) uiWorkspaceRef.current = null
          }, 'sandbox-mesh: uiWorkspace navigation ref')
        })
      }

      // Left Sidebar Main Slot: Signature IM Chat + Group Collaboration + Unified @ / # / Upload Composer
      const MeshChatPage = createMeshChatPage({
        React,
        controller,
        getLocale: () => readActiveLocale(ctx.locale),
        subscribeLocale,
        openAgentSession: (sessionId) => {
          const uiWorkspace = uiWorkspaceRef.current ?? ctx.get?.('uiWorkspace') ?? ctx.uiWorkspace
          if (!sessionId || !uiWorkspace || typeof uiWorkspace.openSession !== 'function') return
          const archived = ctx.get?.('workspaces')?.list?.getSnapshot?.()?.archivedSessionIds
          if (Array.isArray(archived) && archived.includes(sessionId) && typeof uiWorkspace.unarchiveSession === 'function') {
            Promise.resolve(uiWorkspace.unarchiveSession(sessionId))
              .catch(() => {})
              .finally(() => {
                uiWorkspace.openSession(sessionId)
              })
            return
          }
          uiWorkspace.openSession(sessionId)
        },
      })

      // Settings Section Slot: Node Agent Profile + 1-on-1 Pairing + Paired Sandboxes Management
      const MeshSettingsPage = createMeshSettingsPage({
        React,
        controller,
        getLocale: () => readActiveLocale(ctx.locale),
        subscribeLocale,
      })

      function PanelIcon({ size = 18 }) {
        const [, setBadgeTick] = React.useState(0)
        React.useEffect(() => {
          const off = controller.subscribe(() => setBadgeTick((n) => n + 1))
          const bgTimer = typeof setInterval === 'function'
            ? setInterval(() => { void controller.syncFromHost() }, 12000)
            : null
          return () => {
            off()
            if (bgTimer) clearInterval(bgTimer)
          }
        }, [])
        const summary = controller.getUnreadSummary ? controller.getUnreadSummary() : { totalUnread: 0, activeCount: 0, pendingApprovals: 0 }
        const showDot = summary.activeCount > 0 || summary.totalUnread > 0 || (summary.pendingApprovals || 0) > 0
        return React.createElement(
          'span',
          { className: 'sm-nav-icon-wrap' },
          MeshNavIcon({ React, size }),
          showDot
            ? React.createElement('span', {
                className: `sm-nav-badge-dot${summary.pendingApprovals > 0 ? ' warn' : summary.activeCount > 0 ? ' live' : ''}`,
              })
            : null,
        )
      }

      ctx.slots.inject('sidebar.panellist', () =>
        ctx.slots.register(
          {
            name: 'sidebar.panellist',
            id: 'sandbox-mesh',
            order: 25,
            label: () => createTranslator(readActiveLocale(ctx.locale))('panel'),
            locale: 'sandboxMesh',
          },
          PanelIcon,
        ),
      )

      ctx.slots.inject('main', () =>
        ctx.slots.register(
          {
            name: 'main',
            key: 'sandbox-mesh',
            locale: 'sandboxMesh',
          },
          MeshChatPage,
        ),
      )

      ctx.slots.inject('settings.section.icon', () =>
        ctx.slots.register(
          {
            name: 'settings.section.icon',
            id: 'sandbox-mesh',
          },
          function MeshSectionIcon({ size = 16 }) {
            return MeshNavIcon({ React, size })
          },
        ),
      )

      ctx.slots.inject('settings.section', () => {
        let unregister = null
        const syncNav = () => {
          unregister?.()
          const t = createTranslator(readActiveLocale(ctx.locale))
          unregister = ctx.slots.register(
            {
              name: 'settings.section',
              id: 'sandbox-mesh',
              order: 28,
              label: t('nav'),
            },
            MeshSettingsPage,
          )
        }
        syncNav()
        const offLocale = subscribeLocale(() => syncNav())
        return () => {
          offLocale()
          unregister?.()
          unregister = null
        }
      })
    }

    return {
      inject: ['slots', 'locale'],
      apply,
    }
  },
})
