# --- Optional build arguments (`docker compose build`) ----------------------
# DOCKER_REGISTRY=docker.io/library
# APT_MIRROR=deb.debian.org
# NODE_MIRROR=https://nodejs.org/dist
# NPM_REGISTRY=
# PIP_INDEX_URL=https://pypi.org/simple/
# INSTALL_TOOLCHAIN=false
# INSTALL_BROWSER=false
# WORKSPACE_UID=1000
# WORKSPACE_GID=1000
# NODE_VERSION=24.22.3
# DSH_VERSION=0.2.3-alpha.2

# --- Standalone single-container debugging (`make up` / `docker compose up`)
HOST_PORT=8080
CONTAINER_NAME=dsh-sandbox
DSH_IMAGE_REPO=dsh-sandbox
DSH_IMAGE_TAG=latest
# Browser-facing URL when HOST_PORT != 8080 or behind a reverse proxy:
# DSH_PUBLIC_URL=http://localhost:8080/dsh/
# TZ=UTC
