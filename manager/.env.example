DATABASE_URL=sqlite:////data/dsh-manager.db
MANAGER_IMAGE_REPO=dsh-manager
MANAGER_IMAGE_TAG=latest
TRAEFIK_IMAGE=traefik:v3.7
GATEWAY_PORT=9000
DOCKER_API_VERSION=1.44

# --- Optional build-time mirrors (for internal networks / CN mirrors) -------
# PYTHON_IMAGE=python:3.13-slim
# NODE_IMAGE=node:24-bookworm-slim
# APT_MIRROR=https://mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com

DSH_IMAGE_REPO=dsh-sandbox
DSH_IMAGE_TAG=latest
DSH_NETWORK=dsh-manager
# Set true if the Docker daemon is logged in to the registry and may pull.
PULL_MISSING_IMAGE=false
DSH_PERMISSION_MODE=danger-full-access
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2.0
SANDBOX_TIMEZONE=UTC
# Optional host path to a custom/enterprise CA PEM file to mount into sandboxes:
# CUSTOM_CA_BUNDLE_PATH=
HEALTH_TIMEOUT_SECONDS=75

BACKGROUND_TASKS=true
RECONCILE_INTERVAL_SECONDS=60

# --- Authentication mode ----------------------------------------------------
# MANAGER_AUTH_MODE: 'oidc' (SSO), 'token' (admin token + local user password), or 'none'
MANAGER_AUTH_MODE=token

# Bootstrap administrator email (seeded into platform_admins on first start).
MANAGER_ADMIN_EMAIL=admin@example.com
# Required when MANAGER_AUTH_MODE=token (also usable as Bearer token on /api/*).
MANAGER_ADMIN_TOKEN=replace-with-admin-token
# Public manager & gateway URL (used for sandbox URLs, OIDC callbacks, and plugin index links).
MANAGER_PUBLIC_URL=http://localhost:9000
# Internal URL reachable from inside sandbox containers (e.g. http://dsh-manager:9000).
# MANAGER_INTERNAL_URL=http://dsh-manager:9000
# Startup rejects the placeholder; generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret

# --- OIDC settings (required when MANAGER_AUTH_MODE=oidc) -------------------
OIDC_ISSUER_URL=https://idp.example.com/realms/main
# Optional internal metadata URL when Manager runs inside Docker and IdP is behind localhost/NAT:
# OIDC_DISCOVERY_URL=http://dsh-keycloak:8080/realms/main/.well-known/openid-configuration
OIDC_CLIENT_ID=dsh-sandbox
OIDC_CLIENT_SECRET=replace-with-client-secret
OIDC_SCOPE=openid profile email
OIDC_EMAIL_CLAIM=email
# Optional explicit IdP logout endpoint (defaults to discovery end_session_endpoint):
# OIDC_LOGOUT_URL=

# --- Self-Hosted Plugin Index & Registry ------------------------------------
# PLUGIN_SOURCE_TYPE: 'npm' (served directly by manager at /plugins/npm) or 'git'
PLUGIN_SOURCE_TYPE=npm
# Auto-install plugins into newly created sandboxes (comma-separated slugs or URLs):
SANDBOX_AUTO_INSTALL_PLUGINS=file-manager,workspace-user,custom-theme,sandbox-mesh,sandbox-memory
# Optional overrides for custom branding or internal Git hosting:
# PLUGIN_INDEX_TITLE_EN=DSH Sandbox Plugins
# PLUGIN_INDEX_TITLE_ZH=DSH 沙箱平台插件
# PLUGIN_INDEX_AUTHOR=DSH Sandbox Platform
# PLUGIN_GIT_URL=
# PLUGIN_GIT_COMMIT=

# Rootful Docker; on Podman use /run/podman/podman.sock.
DOCKER_SOCKET=/var/run/docker.sock
